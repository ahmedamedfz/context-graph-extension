{
  "name": "bob-context-graph",
  "displayName": "Bob Context Graph",
  "description": "Explore microservice APIs, database schemas and dependencies, and analyze Git-aware change impact in VS Code and IBM Bob.",
  "version": "0.2.0",
  "publisher": "bob-context-graph",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ibm",
    "bob",
    "microservices",
    "context",
    "graph",
    "spring",
    "watsonx"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bob-context-graph",
          "title": "Bob Context Graph",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "bob-context-graph": [
        {
          "id": "bcg.systemOverview",
          "name": "System Overview",
          "type": "tree"
        },
        {
          "id": "bcg.serviceExplorer",
          "name": "Services",
          "type": "tree"
        },
        {
          "id": "bcg.impactPanel",
          "name": "Impact Analysis",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "bcg.openGraph",
        "title": "Bob Context Graph: Open System Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bcg.analyzeChanges",
        "title": "Bob Context Graph: Analyze Changes",
        "icon": "$(diff)"
      },
      {
        "command": "bcg.refreshContext",
        "title": "Bob Context Graph: Refresh Context",
        "icon": "$(refresh)"
      },
      {
        "command": "bcg.refreshAll",
        "title": "Bob Context Graph: Refresh All Services",
        "icon": "$(sync)"
      },
      {
        "command": "bcg.configureAI",
        "title": "Bob Context Graph: Configure AI Provider",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bcg.openGraph",
          "when": "view == bcg.systemOverview",
          "group": "navigation"
        },
        {
          "command": "bcg.refreshAll",
          "when": "view == bcg.serviceExplorer",
          "group": "navigation"
        },
        {
          "command": "bcg.analyzeChanges",
          "when": "view == bcg.impactPanel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Bob Context Graph",
      "properties": {
        "bcg.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Override workspace root for service discovery (defaults to first workspace folder)"
        },
        "bcg.cacheDir": {
          "type": "string",
          "default": "",
          "description": "Directory to store the context cache (defaults to <workspaceRoot>/.context-graph-cache)"
        },
        "bcg.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the MCP server entry point (optional, for custom setups)"
        },
        "bcg.aiProvider": {
          "type": "string",
          "enum": [
            "watsonx",
            "local",
            "none"
          ],
          "enumDescriptions": [
            "IBM watsonx.ai cloud service (requires API key and project ID)",
            "Bundled IBM Granite 4.2 3B, fully offline on macOS Apple Silicon; no Ollama required",
            "Deterministic analysis only \u2014 no AI-powered summaries"
          ],
          "default": "none",
          "description": "AI provider used for service summaries and impact analysis. Set automatically by the setup wizard."
        },
        "bcg.watsonxBaseUrl": {
          "type": "string",
          "default": "https://us-south.ml.cloud.ibm.com",
          "description": "watsonx.ai base URL (advanced \u2014 change only when targeting a different region)"
        },
        "bcg.watsonxModelId": {
          "type": "string",
          "default": "ibm/granite-3-8b-instruct",
          "description": "watsonx.ai model ID to use for text generation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc && node esbuild.js",
    "build:watch": "tsc --watch",
    "package": "node ../../scripts/package-offline.cjs",
    "lint": "echo ok"
  },
  "dependencies": {
    "@bob-context-graph/core": "0.1.0",
    "@bob-context-graph/watsonx": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedamedfz/context-graph-extension.git"
  },
  "license": "MIT",
  "files": [
    "dist/extension.js",
    "resources/**",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ]
}
